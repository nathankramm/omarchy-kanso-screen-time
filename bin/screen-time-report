#!/usr/bin/env bash
# The bar's right-click report menu (D33): copy or save `screen-time report --md`.
#
#   screen-time-report menu     Omarchy's own menu: "Copy report", "Save report"
#   screen-time-report copy     the report to the clipboard (wl-copy)
#   screen-time-report export   the report to ~/Documents/screen-time-YYYY-MM-DD.md
#                               (a temp file, then a rename: never a partial file)
#
# The history is only read, through the engine. On an engine failure a
# notification carries its error and nothing is written. SCREEN_TIME_ENGINE
# overrides the engine path (tests).
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
engine=${SCREEN_TIME_ENGINE:-$here/../python/screen_time.py}
# The system Python, not a `python3` on PATH that may be an older mise/pyenv
# shim (the engine needs 3.11+).
python=${SCREEN_TIME_PYTHON:-/usr/bin/python3}

notify() {
  omarchy-notification-send --app-name "Screen time" "$@" >/dev/null 2>&1 ||
    notify-send -a "Screen time" "$@" >/dev/null 2>&1 || true
}

fail() {
  notify "Screen time report failed" "$1"
  exit 1
}

# The engine's last line of complaint: its stderr, else its stdout.
complaint() {
  local msg
  msg=$(tail -n 1 "$1" 2>/dev/null)
  [[ -z $msg ]] && msg=$(tail -n 1 "$2" 2>/dev/null)
  printf '%s' "${msg:-the engine failed}"
}

copy_report() {
  local out err
  out=$(mktemp) && err=$(mktemp) || fail "no temp file"
  if ! "$python" "$engine" report --md >"$out" 2>"$err"; then
    local msg
    msg=$(complaint "$err" "$out")
    rm -f "$out" "$err"
    fail "$msg"
  fi
  if ! wl-copy <"$out"; then
    rm -f "$out" "$err"
    fail "the clipboard refused it (wl-copy)"
  fi
  rm -f "$out" "$err"
  notify "Report copied"
}

export_report() {
  local dir="$HOME/Documents" day path tmp err
  day=$(date +%F)
  path="$dir/screen-time-$day.md"
  mkdir -p "$dir" || fail "cannot create $dir"
  # in the same directory, so the rename is atomic
  tmp=$(mktemp "$dir/.screen-time-$day.XXXXXX.tmp") || fail "cannot write in $dir"
  err=$(mktemp) || {
    rm -f "$tmp"
    fail "no temp file"
  }
  if ! "$python" "$engine" report --md >"$tmp" 2>"$err"; then
    local msg
    msg=$(complaint "$err" "$tmp")
    rm -f "$tmp" "$err"
    fail "$msg"
  fi
  rm -f "$err"
  if ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    fail "cannot save $path"
  fi
  notify "Report saved · $path"
}

case "${1:-menu}" in
  menu)
    choice=$(omarchy-menu-select "Screen time" "Copy report" "Save report") || exit 0
    case "$choice" in
      "Copy report") copy_report ;;
      "Save report") export_report ;;
      *) exit 0 ;;
    esac
    ;;
  copy) copy_report ;;
  export) export_report ;;
  *)
    echo "usage: screen-time-report menu|copy|export" >&2
    exit 2
    ;;
esac
