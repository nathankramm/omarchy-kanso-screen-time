#!/usr/bin/env bash
# The bar's right-click report menu (D33): ask an agent about, copy or save
# `screen-time report --md`.
#
#   screen-time-report ask      the report to a file under
#                               $XDG_STATE_HOME/kanso-screen-time/, then the
#                               default coding agent opened on it; Claude starts
#                               in plan mode (open_agent, as Kanso Disk Space's)
#   screen-time-report menu     Omarchy's own menu: "Ask agent", "Copy report",
#                               "Save report" (Kanso Disk Space's order)
#   screen-time-report copy     the report to the clipboard (wl-copy)
#   screen-time-report export   the report to ~/Documents/screen-time-YYYY-MM-DD.md
#                               (a temp file, then a rename: never a partial file)
#
# The history is only read, through the engine. On an engine failure a
# notification carries its error and nothing is written. SCREEN_TIME_ENGINE
# overrides the engine path (tests).
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
engine=${SCREEN_TIME_ENGINE:-$here/../python/screen_time.py}
# The system Python, not a `python3` on PATH that may be an older mise/pyenv
# shim (the engine needs 3.11+).
python=${SCREEN_TIME_PYTHON:-/usr/bin/python3}
state=${XDG_STATE_HOME:-$HOME/.local/state}/kanso-screen-time

notify() {
  omarchy-notification-send --app-name "Screen time" "$@" >/dev/null 2>&1 ||
    notify-send -a "Screen time" "$@" >/dev/null 2>&1 || true
}

fail() {
  notify "Screen time report failed" "$1"
  exit 1
}

# The engine's last line of complaint: its stderr, else its stdout.
complaint() {
  local msg
  msg=$(tail -n 1 "$1" 2>/dev/null)
  [[ -z $msg ]] && msg=$(tail -n 1 "$2" 2>/dev/null)
  printf '%s' "${msg:-the engine failed}"
}

copy_report() {
  local out err
  out=$(mktemp) && err=$(mktemp) || fail "no temp file"
  if ! "$python" "$engine" report --md >"$out" 2>"$err"; then
    local msg
    msg=$(complaint "$err" "$out")
    rm -f "$out" "$err"
    fail "$msg"
  fi
  if ! wl-copy <"$out"; then
    rm -f "$out" "$err"
    fail "the clipboard refused it (wl-copy)"
  fi
  rm -f "$out" "$err"
  notify "Report copied"
}

# The report to $1: a temp file in the same directory, so the rename is
# atomic and never leaves a partial file.
write_report() {
  local path=$1 dir tmp err
  dir=$(dirname "$path")
  mkdir -p "$dir" || fail "cannot create $dir"
  tmp=$(mktemp "$dir/.$(basename "$path" .md).XXXXXX.tmp") || fail "cannot write in $dir"
  err=$(mktemp) || {
    rm -f "$tmp"
    fail "no temp file"
  }
  if ! "$python" "$engine" report --md >"$tmp" 2>"$err"; then
    local msg
    msg=$(complaint "$err" "$tmp")
    rm -f "$tmp" "$err"
    fail "$msg"
  fi
  rm -f "$err"
  if ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    fail "cannot save $path"
  fi
}

export_report() {
  local path
  path="$HOME/Documents/screen-time-$(date +%F).md"
  write_report "$path"
  notify "Report saved · $path"
}

# omarchy-agent's own two checks, made before anything is written: it reports
# a missing default or a missing agent on stderr and exits 1, which from the
# bar's detached launch is no sign at all.
agent_ready() {
  local agent
  agent=$(omarchy-default-agent 2>/dev/null)
  if [[ -z $agent ]]; then
    notify "No default agent — use Copy report" "Choose one with: omarchy default agent <name>"
    return 1
  fi
  # omarchy-agent lets OpenClaw's package stand in for its command
  if ! command -v -- "$agent" >/dev/null &&
    ! { [[ $agent == openclaw ]] && omarchy-pkg-present openclaw >/dev/null 2>&1; }; then
    notify "$agent is not installed — use Copy report" \
      "Choose an installed agent with: omarchy default agent <name>"
    return 1
  fi
}

ask() {
  local path
  agent_ready || exit 1
  path="$state/report-$(date +%Y-%m-%dT%H%M%S).md"
  write_report "$path"
  open_agent "I want to understand my screen time on this Omarchy machine. Read the report at $path and answer my questions from it."
}

# Claude starts in plan mode: it reads and proposes, and runs nothing until
# the user approves the plan (Kanso Disk Space's D33). omarchy-agent always passes Claude
# --permission-mode auto, so for Claude this launches it the way omarchy-agent
# does: the same window class, the same account home, and ~/Work instead of
# $HOME (Claude never remembers trust for $HOME). Every other agent goes
# through omarchy-agent.
open_agent() {
  local prompt=$1 home launch=()
  if [[ $(omarchy-default-agent 2>/dev/null) != claude ]] || ! command -v claude >/dev/null; then
    exec omarchy-agent --prompt "$prompt"
  fi
  if [[ -v OMARCHY_AGENT_CLAUDE_HOME && ${CLAUDE_CONFIG_DIR:-} == "$OMARCHY_AGENT_CLAUDE_HOME" ]]; then
    unset CLAUDE_CONFIG_DIR
  fi
  unset OMARCHY_AGENT_CLAUDE_HOME
  [[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"
  if [[ -z ${CLAUDE_CONFIG_DIR:-} ]]; then
    home=$(omarchy-agent-account-home claude 2>/dev/null)
    launch=(env -u CLAUDE_CONFIG_DIR "OMARCHY_AGENT_CLAUDE_HOME=$home")
    [[ -n $home ]] && launch+=("CLAUDE_CONFIG_DIR=$home")
  fi
  exec omarchy-launch-tui --app-id=org.omarchy.agent "${launch[@]}" claude --permission-mode plan -- "$prompt"
}

case "${1:-menu}" in
  menu)
    choice=$(omarchy-menu-select "Screen time" "Ask agent" "Copy report" "Save report") || exit 0
    case "$choice" in
      "Ask agent") ask ;;
      "Copy report") copy_report ;;
      "Save report") export_report ;;
      *) exit 0 ;;
    esac
    ;;
  ask) ask ;;
  copy) copy_report ;;
  export) export_report ;;
  *)
    echo "usage: screen-time-report menu|ask|copy|export" >&2
    exit 2
    ;;
esac
